rules_version = '2';

// Focal Firestore rules with family isolation.
//
// Login token claims:
//   parent: { role: "parent" }                              family = auth.uid
//   child:  { role: "child", parentId, childId, deviceId }  family = token.parentId
//   admin:  { role: "admin" }
//
// Rule of thumb: every document carries parentId; a caller only ever sees or
// writes documents of its own family, and may never change a document's
// parentId/childId. Card, order, tap, pairing and subscription documents are
// written only by Cloud Functions (Admin SDK bypasses these rules).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin()  { return signedIn() && request.auth.token.role == 'admin'; }
    function isParent() { return signedIn() && request.auth.token.role == 'parent'; }
    function isChild()  { return signedIn() && request.auth.token.role == 'child'; }

    // parent owns an existing / new document
    function parentOwns()    { return isParent() && resource.data.parentId == request.auth.uid; }
    function parentOwnsNew() { return isParent() && request.resource.data.parentId == request.auth.uid; }

    // child device acting on its own child's documents
    function childOwns() {
      return isChild()
        && resource.data.parentId == request.auth.token.parentId
        && resource.data.childId == request.auth.token.childId;
    }
    function childOwnsNew() {
      return isChild()
        && request.resource.data.parentId == request.auth.token.parentId
        && request.resource.data.childId == request.auth.token.childId;
    }

    function unchanged(fields) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }
    function onlyChanges(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    // ---------------------------------------------------------------- accounts
    match /parents/{parentId} {
      allow read: if (isParent() && request.auth.uid == parentId)
                  || (isChild() && request.auth.token.parentId == parentId)
                  || isAdmin();
      // billing fields are set by the payment webhook only
      allow create: if isParent() && request.auth.uid == parentId
                    && !request.resource.data.keys().hasAny(['role', 'subscriptionStatus', 'trialEndsAt', 'nextBillingDate', 'monthlyPriceInr']);
      allow update: if isParent() && request.auth.uid == parentId
                    && unchanged(['role', 'subscriptionStatus', 'trialEndsAt', 'nextBillingDate', 'monthlyPriceInr']);
      allow delete: if false;
    }

    match /children/{childId} {
      allow read: if parentOwns()
                  || (isChild() && request.auth.token.childId == childId && resource.data.parentId == request.auth.token.parentId)
                  || isAdmin();
      allow create: if parentOwnsNew();
      allow update: if (parentOwns() && unchanged(['parentId']))
                    || (isChild() && request.auth.token.childId == childId
                        && resource.data.parentId == request.auth.token.parentId
                        && onlyChanges(['isOnline', 'isFocusing', 'currentSessionId', 'todayFocusMinutes', 'streakDays']));
      allow delete: if parentOwns();
    }

    match /devices/{deviceId} {
      allow read: if (isChild() && request.auth.token.deviceId == deviceId) || parentOwns() || isAdmin();
      allow create: if false;  // redeemPairingCode creates it
      allow update: if isChild() && request.auth.token.deviceId == deviceId
                    && unchanged(['parentId', 'childId', 'hardwarePublicKey']);
      allow delete: if parentOwns();  // parent unpairs a phone
    }

    // ---------------------------------------------------------------- parent settings
    match /policies/{policyId} {
      allow read: if parentOwns() || childOwns() || isAdmin();
      allow create: if parentOwnsNew();
      allow update: if parentOwns() && unchanged(['parentId']);
      allow delete: if parentOwns();
    }

    match /schedules/{scheduleId} {
      allow read: if parentOwns() || childOwns() || isAdmin();
      allow create: if parentOwnsNew();
      allow update: if parentOwns() && unchanged(['parentId']);
      allow delete: if parentOwns();
    }

    match /commands/{commandId} {
      allow read: if parentOwns() || childOwns() || isAdmin();
      allow create: if parentOwnsNew();
      allow update: if childOwns() && onlyChanges(['status']);
      allow delete: if false;
    }

    // ---------------------------------------------------------------- child activity
    match /sessions/{sessionId} {
      allow read: if parentOwns() || childOwns() || isAdmin();
      allow create: if childOwnsNew() || parentOwnsNew();
      allow update: if (childOwns() || parentOwns()) && unchanged(['parentId', 'childId']);
      allow delete: if false;
    }

    match /events/{eventId} {
      allow read: if parentOwns() || isAdmin();
      allow create: if childOwnsNew();
      allow update, delete: if false;
    }

    match /usageDaily/{usageId} {
      allow read: if parentOwns() || isAdmin();
      allow create: if childOwnsNew();
      allow update: if childOwns() && unchanged(['parentId', 'childId']);
      allow delete: if false;
    }

    match /notifications/{notificationId} {
      allow read: if signedIn() && resource.data.recipientUserId == request.auth.uid;
      allow update: if signedIn() && resource.data.recipientUserId == request.auth.uid && onlyChanges(['isRead']);
      allow create, delete: if false;
    }

    // ---------------------------------------------------------------- server-only
    // NFC cards: parents may list their own cards; nobody writes from an app.
    match /cards/{serial} {
      allow read: if parentOwns() || isAdmin();
      allow write: if false;
    }
    match /cardTaps/{tapId} {
      allow read: if parentOwns() || isAdmin();
      allow write: if false;
    }
    match /cardOrders/{orderId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /pairingCodes/{codeId} {
      allow read: if parentOwns() || isAdmin();
      allow write: if false;
    }
    match /subscriptions/{subId} {
      allow read: if parentOwns() || isAdmin();
      allow write: if false;
    }
    match /adminAudit/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // anything not listed above: no access
  }
}
